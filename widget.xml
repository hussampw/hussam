<b:widget id='Blog1' locked='true' title='رسائل المدونة الإلكترونية' type='Blog' version='1'>
  <b:widget-settings>
    <b:widget-setting name='showDateHeader'>true</b:widget-setting>
    <b:widget-setting name='showShareButtons'>true</b:widget-setting>
    <b:widget-setting name='authorLabel'>By</b:widget-setting>
    <b:widget-setting name='showCommentLink'>true</b:widget-setting>
    <b:widget-setting name='showAuthor'>false</b:widget-setting>
    <b:widget-setting name='style.unittype'>TextAndImage</b:widget-setting>
    <b:widget-setting name='reactionsLabel'/>
    <b:widget-setting name='showAuthorProfile'>false</b:widget-setting>
    <b:widget-setting name='style.layout'>1x1</b:widget-setting>
    <b:widget-setting name='showLabels'>true</b:widget-setting>
    <b:widget-setting name='showLocation'>true</b:widget-setting>
    <b:widget-setting name='showTimestamp'>true</b:widget-setting>
    <b:widget-setting name='postsPerAd'>1</b:widget-setting>
    <b:widget-setting name='showBacklinks'>false</b:widget-setting>
    <b:widget-setting name='showInlineAds'>false</b:widget-setting>
    <b:widget-setting name='showReactions'>false</b:widget-setting>
  </b:widget-settings>
  <b:includable id='main' var='top'><b:if cond='data:view.isHomepage or ((data:blog.url contains &quot;/p/arabic.html&quot;) and !data:view.isError)'><section class='wrap latest' data-stage='journal' id='writing'><div class='section-heading' data-reveal='data-reveal'><span class='kicker'>05 / JOURNAL</span><h2><b:if cond='data:blog.url contains &quot;/p/arabic.html&quot;'>من تدويناتي<b:else/>Notes from my desk.</b:if></h2><a class='text-link' href='/search'>All articles / جميع المقالات &#8599;</a></div><div class='blog-list'><b:if cond='!data:posts'><p>Read the journal / تصفح المقالات</p></b:if><b:loop index='i' values='data:posts' var='post'><b:if cond='data:i &lt; 3'><article class='post-card' data-reveal='data-reveal' dir='auto'><div class='post-meta'><data:post.timestamp/></div><h3><a expr:href='data:post.url'><data:post.title/></a></h3><p><data:post.snippet/></p><a class='text-link' expr:href='data:post.url'>Read / اقرأ &#8599;</a></article></b:if></b:loop></div></section></b:if>
<b:if cond='!data:view.isHomepage and !(data:blog.url contains &quot;/p/arabic.html&quot;) and !data:view.isError'>
<div class='wrap page-pad'><b:if cond='!data:view.isSingleItem'><section><span class='kicker'>Journal / المقالات</span><h1>Notes on building<br/>useful digital products.</h1><p class='post-meta'>Articles in their original language. English and Arabic.</p><form action='/search' class='search' method='get'><label class='u-sr' for='journal-search'>Search the journal</label><input id='journal-search' name='q' placeholder='Search the journal' type='search'/><button class='btn' type='submit'>Search</button></form><b:if cond='!data:posts'><p class='empty'>No articles found. Try a different search.</p></b:if><div class='blog-list'><b:loop values='data:posts' var='post'><article class='post-card' dir='auto'><b:if cond='data:post.thumbnailUrl'><a aria-hidden='true' expr:href='data:post.url' tabindex='-1'><img alt='' expr:src='data:post.thumbnailUrl' height='180' loading='lazy' width='360'/></a></b:if><h2><a expr:href='data:post.url'><data:post.title/></a></h2><div class='post-meta'><data:post.timestamp/></div><p><data:post.snippet/></p><a class='text-link' expr:href='data:post.url'>Read article / اقرأ المقال &#8599;</a></article></b:loop><nav aria-label='Journal pagination' class='pager'><b:if cond='data:newerPageUrl'><a class='text-link' expr:href='data:newerPageUrl'>&#8592; Newer articles</a></b:if><b:if cond='data:olderPageUrl'><a class='text-link' expr:href='data:olderPageUrl'>Older articles &#8594;</a></b:if></nav></div></section><b:else/>
<b:loop values='data:posts' var='post'><article class='article' dir='auto' expr:itemtype='data:view.isPost ? &quot;https://schema.org/BlogPosting&quot; : &quot;https://schema.org/WebPage&quot;' itemscope='itemscope'><meta expr:content='data:post.url' itemprop='url'/><meta expr:content='data:post.url' itemprop='mainEntityOfPage'/><b:if cond='data:post.thumbnailUrl'><meta expr:content='data:post.thumbnailUrl' itemprop='image'/></b:if><a class='text-link' href='/search'>Journal / المقالات</a><h1 itemprop='headline' style='margin-top:25px'><data:post.title/></h1><b:if cond='data:view.isPost'><div class='post-meta'><time expr:datetime='data:post.timestampISO8601' itemprop='datePublished'><data:post.timestamp/></time></div></b:if><div class='post-body' expr:itemprop='data:view.isPost ? &quot;articleBody&quot; : &quot;text&quot;'><data:post.body/></div><b:if cond='data:post.labels'><div class='labels'><b:loop values='data:post.labels' var='label'><a expr:href='data:label.url'><data:label.name/></a></b:loop></div></b:if><b:if cond='data:post.allowComments'><b:include data='post' name='comment_picker'/></b:if></article></b:loop>
</b:if></div></b:if></b:includable>
  <b:includable id='comment_picker' var='post'><b:if cond='data:post.commentSource == 1'><b:include data='post' name='iframe_comments'/><b:else/><b:include data='post' name='comments'/></b:if></b:includable>
  <b:includable id='iframe_comments' var='post'><b:if cond='data:post.allowIframeComments'><script expr:src='data:post.iframeCommentSrc' type='text/javascript'></script><div class='cmt_iframe_holder' expr:data-href='data:post.canonicalUrl' expr:data-viewtype='data:post.viewType'></div><b:if cond='data:post.embedCommentForm == &quot;false&quot;'><a expr:href='data:post.addCommentUrl' expr:onclick='data:post.addCommentOnclick'><data:postCommentMsg/></a></b:if></b:if></b:includable>
  <b:includable id='comments' var='post'><section class='comments' id='comments'><a name='comments'></a><b:if cond='data:post.allowComments'><h2><b:if cond='data:post.numComments == 1'>1 <data:commentLabel/><b:else/><data:post.numComments/> <data:commentLabelPlural/></b:if></h2><dl id='comments-block'><b:loop values='data:post.comments' var='comment'><dt class='comment-author' expr:id='data:comment.anchorName'><a expr:name='data:comment.anchorName'></a><b:if cond='data:comment.authorUrl'><a expr:href='data:comment.authorUrl' rel='nofollow'><data:comment.author/></a><b:else/><data:comment.author/></b:if></dt><dd class='comment-body'><p><data:comment.body/></p></dd><dd class='comment-footer'><a expr:href='data:comment.url' title='comment permalink'><data:comment.timestamp/></a></dd></b:loop></dl><b:if cond='data:post.embedCommentForm'><b:if cond='data:post.allowNewComments'><b:include data='post' name='comment-form'/><b:else/><data:post.noNewCommentsText/></b:if><b:else/><a expr:href='data:post.addCommentUrl' expr:onclick='data:post.addCommentOnclick'><data:postCommentMsg/></a></b:if></b:if></section></b:includable>
  <b:includable id='comment-form' var='post'><div class='comment-form'><a name='comment-form'></a><h4 id='comment-post-message'><data:postCommentMsg/></h4><p><data:blogCommentMessage/></p><data:blogTeamBlogMessage/><a expr:href='data:post.commentFormIframeSrc' id='comment-editor-src'></a><iframe allowtransparency='true' class='blogger-iframe-colorize blogger-comment-from-post' frameborder='0' height='410' id='comment-editor' name='comment-editor' src='' width='100%'></iframe><data:post.friendConnectJs/><data:post.cmtfpIframe/><script type='text/javascript'>BLOG_CMT_createIframe('<data:post.appRpcRelayPath/>', '<data:post.communityId/>');</script></div></b:includable>
</b:widget>
